    "chatbot.consent.intro" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Преди да използвате асистента за разходи, моля, прегледайте какво изпращаме и кой го получава. Ние изпращаме данни само след като се съгласите по-долу."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Než použijete asistenta výdajů, zkontrolujte, co posíláme a kdo to přijímá. Údaje zasíláme pouze po níže uvedeném souhlasu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Før du bruger udgiftsassistenten, bedes du gennemgå, hvad vi sender, og hvem der modtager det. Vi sender kun data, når du har accepteret nedenfor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bevor Sie den Spesenassistenten verwenden, überprüfen Sie bitte, was wir senden und wer es erhält. Wir senden Daten nur, nachdem Sie unten zugestimmt haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προτού χρησιμοποιήσετε τον Βοηθό Εξόδων, ελέγξτε τι στέλνουμε και ποιος το λαμβάνει. Στέλνουμε δεδομένα μόνο αφού συμφωνήσετε παρακάτω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before you use the Expense assistant, please review what we send and who receives it. We only send data after you agree below."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Before you use the Expense assistant, please review what we send and who receives it. We only send data after you agree below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de utilizar el asistente de gastos, revise lo que enviamos y quién lo recibe. Solo enviamos datos después de que usted acepte a continuación."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enne kuluassistendi kasutamist vaadake üle, mida me saadame ja kes selle vastu võtab. Saadame andmeid alles pärast seda, kui nõustute allpool."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ennen kuin käytät Expense Assistantia, tarkista, mitä lähetämme ja kuka sen vastaanottaa. Lähetämme tiedot vasta, kun hyväksyt alla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avant d'utiliser l'assistant Dépenses, veuillez vérifier ce que nous envoyons et qui le reçoit. Nous n'envoyons des données qu'après votre accord ci-dessous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "व्यय सहायक का उपयोग करने से पहले, कृपया समीक्षा करें कि हम क्या भेजते हैं और इसे कौन प्राप्त करता है। हम आपकी सहमति के बाद ही डेटा भेजते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prije nego što upotrijebite pomoćnika za troškove, pregledajte što šaljemo i tko to prima. Podatke šaljemo tek nakon što pristanete u nastavku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Költségkezelő használata előtt kérjük, tekintse át, hogy mit küldünk és ki kapja meg. Csak akkor küldünk adatokat, ha Ön alább beleegyezik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di utilizzare l'Assistente spese, controlla cosa inviamo e chi lo riceve. Inviamo i dati solo dopo aver accettato di seguito."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prieš naudodamiesi išlaidų asistentu, peržiūrėkite, ką siunčiame ir kas tai gauna. Duomenis siunčiame tik tada, kai sutinkate toliau."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pirms izmantojat Izdevumu palīgu, lūdzu, pārskatiet, ko mēs sūtām un kas to saņem. Mēs nosūtām datus tikai pēc tam, kad piekrītat tālāk norādītajam."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voordat u de Onkostenassistent gebruikt, moet u controleren wat we verzenden en wie het ontvangt. Wij versturen alleen gegevens nadat u hieronder akkoord gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zanim skorzystasz z Asystenta wydatków, sprawdź, co wysyłamy i kto to otrzymuje. Dane wysyłamy dopiero po wyrażeniu zgody poniżej."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de usar o Assistente de despesas, veja o que enviamos e quem recebe. Só enviamos dados depois que você concordar abaixo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de usar o Assistente de despesas, veja o que enviamos e quem recebe. Só enviamos dados depois que você concordar abaixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de usar o Assistente de despesas, veja o que enviamos e quem recebe. Só enviamos dados depois de concordar abaixo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Înainte de a utiliza Asistentul pentru cheltuieli, vă rugăm să examinați ce trimitem și cine îl primește. Trimitem date numai după ce sunteți de acord mai jos."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Predtým, ako použijete asistenta výdavkov, skontrolujte, čo posielame a kto to dostáva. Údaje posielame až po vašom súhlase nižšie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preden uporabite pomočnika za stroške, preverite, kaj pošiljamo in kdo to prejema. Podatke pošljemo šele, ko se spodaj strinjate."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innan du använder Expense-assistenten, vänligen granska vad vi skickar och vem som tar emot det. Vi skickar endast data efter att du godkänt nedan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在使用费用助手之前，请查看我们发送的内容以及接收者。我们仅在您同意以下内容后才发送数据。"
          }
        }
      }
    },

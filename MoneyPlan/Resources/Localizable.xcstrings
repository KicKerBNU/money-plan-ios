          "stringUnit": {
            "state": "translated",
            "value": "Contant geld, bankrekeningen en kaarten die worden gebruikt voor inkomsten en uitgaven."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετρητά, τραπεζικοί λογαριασμοί και κάρτες που χρησιμοποιούνται στα έσοδα και τα έξοδα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotovina, bankovni računi i kartice koje se koriste za prihode i rashode."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontanter, bankkonton och kort som används över intäkter och kostnader."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bargeld, Bankkonten und Karten, die für Einnahmen und Ausgaben verwendet werden."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Парични средства, банкови сметки и карти, използвани за приходи и разходи."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hotovost, bankovní účty a karty používané napříč příjmy a výdaji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",

    "accountsPage.form.defaultLockedFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your default account. Set another account as default to change it."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your default account. Set another account as default to change it."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a sua conta predefinida. Defina outra conta como predefinida para alterar."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a sua conta padrão. Defina outra conta como padrão para alterar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é a sua conta predefinida. Defina outra conta como predefinida para alterar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es su cuenta predeterminada. Establezca otra cuenta como predeterminada para cambiarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est votre compte par défaut. Définissez un autre compte par défaut pour le modifier."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il tuo account predefinito. Imposta un altro account come predefinito per modificarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is uw standaardaccount. Stel een ander account in als standaard om het te wijzigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτός είναι ο προεπιλεγμένος λογαριασμός σας. Ορίστε έναν άλλο λογαριασμό ως προεπιλογή για να τον αλλάξετε."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo je vaš zadani račun. Postavite drugi račun kao zadani da biste ga promijenili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta är ditt standardkonto. Ställ in ett annat konto som standard för att ändra det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist Ihr Standardkonto. Legen Sie ein anderes Konto als Standard fest, um es zu ändern."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това е вашият акаунт по подразбиране. Задайте друг акаунт по подразбиране, за да го промените."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je váš výchozí účet. Chcete-li jej změnit, nastavte jako výchozí jiný účet."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er din standardkonto. Indstil en anden konto som standard for at ændre den."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See on teie vaikekonto. Selle muutmiseks määrake teine ​​konto vaikekontoks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on oletustilisi. Aseta toinen tili oletukseksi muuttaaksesi sitä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez az alapértelmezett fiókod. A módosításhoz állítson be egy másik fiókot alapértelmezettként."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis ir jūsu noklusējuma konts. Iestatiet citu kontu kā noklusējuma kontu, lai to mainītu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai yra jūsų numatytoji paskyra. Nustatykite kitą paskyrą kaip numatytąją, kad ją pakeistumėte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To jest Twoje konto domyślne. Ustaw inne konto jako domyślne, aby je zmienić."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesta este contul dvs. implicit. Setați alt cont ca implicit pentru a-l schimba."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je váš predvolený účet. Ak ho chcete zmeniť, nastavte ako predvolený iný účet."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "To je vaš privzeti račun. Nastavite drug račun kot privzetega, da ga spremenite."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您的默认帐户。将另一个帐户设置为默认帐户以进行更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपका डिफ़ॉल्ट खाता है. इसे बदलने के लिए किसी अन्य खाते को डिफ़ॉल्ट के रूप में सेट करें।"
          }
        }
      }
    },

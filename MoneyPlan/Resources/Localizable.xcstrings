    "Recent expenses": {},
    "recurring.confirmDelete.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past expenses stay in your history. Future repeats will not be scheduled."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Past expenses stay in your history. Future repeats will not be scheduled."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Despesas passadas permanecem no histórico. Repetições futuras serão canceladas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Despesas passadas permanecem no histórico. Repetições futuras serão canceladas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Despesas passadas permanecem no histórico. Repetições futuras serão canceladas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gastos pasados ​​permanecen en su historial. No se programarán repeticiones futuras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dépenses passées restent dans votre historique. Les prochaines répétitions ne seront pas programmées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le spese passate rimangono nella tua cronologia. Non saranno previste future repliche."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgaven uit het verleden blijven in uw geschiedenis staan. Toekomstige herhalingen zullen niet worden gepland."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα προηγούμενα έξοδα παραμένουν στο ιστορικό σας. Οι μελλοντικές επαναλήψεις δεν θα προγραμματιστούν."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prošli troškovi ostaju u vašoj povijesti. Buduća ponavljanja neće biti zakazana."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidigare utgifter finns kvar i din historia. Framtida repetitioner kommer inte att planeras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergangene Ausgaben bleiben in Ihrem Verlauf. Zukünftige Wiederholungen werden nicht geplant."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Миналите разходи остават в историята ви. Бъдещи повторения няма да бъдат планирани."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Minulé výdaje zůstanou ve vaší historii. Budoucí opakování nebude plánováno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidligere udgifter forbliver i din historie. Fremtidige gentagelser vil ikke blive planlagt."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Varasemad kulud jäävad teie ajalukku. Tulevasi kordusi ei planeerita."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Menneet kulut jäävät historiaan. Tulevia toistoja ei ajoiteta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A múltbeli kiadások a történelemben maradnak. A jövőbeni ismétlések nem lesznek ütemezve."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Iepriekšējie izdevumi paliek jūsu vēsturē. Turpmākie atkārtojumi netiks ieplānoti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ankstesnės išlaidos lieka jūsų istorijoje. Būsimi pakartojimai nebus suplanuoti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcześniejsze wydatki pozostają w Twojej historii. Przyszłe powtórki nie będą planowane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheltuielile anterioare rămân în istoria ta. Repetările viitoare nu vor fi programate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Minulé výdavky zostanú vo vašej histórii. Budúce opakovania nebudú naplánované."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretekli stroški ostanejo v vaši zgodovini. Prihodnje ponovitve ne bodo predvidene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去的开支会留在您的历史记录中。未来不会安排重复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले खर्च आपके इतिहास में रहते हैं। भविष्य में दोहराव निर्धारित नहीं होंगे."
          }
        }
      }
    },

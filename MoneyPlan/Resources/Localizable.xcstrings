        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomsten, uitgaven en saldi voor elke week, maand of jaar."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Έσοδα, δαπάνες και υπόλοιπα για οποιαδήποτε εβδομάδα, μήνα ή έτος."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihod, potrošnja i stanja za bilo koji tjedan, mjesec ili godinu."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomster, utgifter och saldon för varje vecka, månad eller år."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einnahmen, Ausgaben und Salden für jede Woche, jeden Monat oder jedes Jahr."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приходи, разходи и салда за всяка седмица, месец или година."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příjmy, výdaje a zůstatky za jakýkoli týden, měsíc nebo rok."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indkomst, forbrug og saldi for enhver uge, måned eller år."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Iga nädala, kuu või aasta sissetulekud, kulutused ja saldod."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulot, menot ja saldot mille tahansa viikolle, kuukaudelle tai vuodelle."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevételek, kiadások és egyenlegek bármely hétre, hónapra vagy évre."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ienākumi, izdevumi un atlikumi jebkurā nedēļā, mēnesī vai gadā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bet kurios savaitės, mėnesio ar metų pajamos, išlaidos ir likučiai."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dochody, wydatki i salda w dowolnym tygodniu, miesiącu lub roku."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Venituri, cheltuieli și solduri pentru orice săptămână, lună sau an."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Príjmy, výdavky a zostatky za každý týždeň, mesiac alebo rok."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dohodek, poraba in stanja za kateri koli teden, mesec ali leto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何一周、一个月或一年的收入、支出和余额。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी सप्ताह, महीने या वर्ष के लिए आय, व्यय और शेष राशि।"
          }
        }
      }
    },

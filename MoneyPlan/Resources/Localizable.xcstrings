    "auth.login.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Влезте, за да получите достъп до помощника си за разходи, приходи и разходи. Всички функции изискват акаунт и вашите лични данни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přihlaste se a získejte přístup ke svému asistentovi výdajů, příjmů a výdajů. Všechny funkce vyžadují účet a vaše soukromá data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind for at få adgang til din udgifts-, indtægts- og udgiftsassistent. Alle funktioner kræver en konto og dine private data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melden Sie sich an, um auf Ihren Ausgaben-, Einnahmen- und Ausgabenassistenten zuzugreifen. Für alle Funktionen sind ein Konto und Ihre privaten Daten erforderlich."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδεθείτε για να αποκτήσετε πρόσβαση στον βοηθό εξόδων, εσόδων και εξόδων. Όλες οι λειτουργίες απαιτούν λογαριασμό και τα προσωπικά σας δεδομένα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to access your expenses, income, and expense assistant. All features require an account and your private data."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to access your expenses, income, and expense assistant. All features require an account and your private data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para acceder a tu asistente de gastos, ingresos y gastos. Todas las funciones requieren una cuenta y sus datos privados."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logige sisse, et pääseda juurde oma kulude, tulude ja kulude abistajale. Kõik funktsioonid nõuavad kontot ja teie privaatseid andmeid."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjaudu sisään käyttääksesi kulujasi, tulojasi ja kuluassistenttiasi. Kaikki ominaisuudet vaativat tilin ja yksityiset tietosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous pour accéder à vos dépenses, revenus et assistant de dépenses. Toutes les fonctionnalités nécessitent un compte et vos données privées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने व्यय, आय और व्यय सहायक तक पहुंचने के लिए साइन इन करें। सभी सुविधाओं के लिए एक खाते और आपके निजी डेटा की आवश्यकता होती है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavite se za pristup svom pomoćniku za troškove, prihode i troškove. Sve značajke zahtijevaju račun i vaše privatne podatke."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jelentkezzen be a kiadások, bevételek és kiadási asszisztens eléréséhez. Minden funkcióhoz fiókra és személyes adataira van szükség."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi per accedere alle tue spese, entrate e assistente spese. Tutte le funzionalità richiedono un account e i tuoi dati privati."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisijunkite, kad pasiektumėte savo išlaidų, pajamų ir išlaidų asistentą. Visoms funkcijoms reikia paskyros ir asmeninių duomenų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pierakstieties, lai piekļūtu saviem izdevumiem, ienākumiem un izdevumu palīgam. Visām funkcijām ir nepieciešams konts un jūsu privātie dati."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meld u aan om toegang te krijgen tot uw uitgaven-, inkomsten- en onkostenassistent. Voor alle functies zijn een account en uw privégegevens vereist."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaloguj się, aby uzyskać dostęp do asystenta wydatków, dochodów i wydatków. Wszystkie funkcje wymagają konta i prywatnych danych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão para aceder às suas despesas, receitas e assistente de despesas. Todas as funcionalidades exigem conta e os seus dados privados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão para acessar suas despesas, receitas e assistente de despesas. Todos os recursos exigem conta e seus dados privados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie sessão para aceder às suas despesas, receitas e assistente de despesas. Todas as funcionalidades exigem conta e os seus dados privados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conectați-vă pentru a vă accesa asistentul pentru cheltuieli, venituri și cheltuieli. Toate funcțiile necesită un cont și datele dumneavoastră private."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihláste sa a získajte prístup k asistentovi výdavkov, príjmov a výdavkov. Všetky funkcie vyžadujú účet a vaše súkromné ​​údaje."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijavite se za dostop do pomočnika za stroške, prihodke in stroške. Vse funkcije zahtevajo račun in vaše osebne podatke."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logga in för att komma åt din utgifts-, inkomst- och utgiftsassistent. Alla funktioner kräver ett konto och din privata data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登录以访问您的费用、收入和费用助手。所有功能都需要一个帐户和您的私人数据。"
          }
        }
      }
    },

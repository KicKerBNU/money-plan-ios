    "expenses.confirmDelete.accountBody" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Акаунтът ще бъде премахнат от вашите списъци. Запазват се минали разходи и приходи, свързани с него."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet bude odstraněn z vašich seznamů. Minulé výdaje a příjmy s tím spojené jsou zachovány."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontoen vil blive fjernet fra dine lister. Tidligere udgifter og indtægter knyttet hertil beholdes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Konto wird aus Ihren Listen entfernt. Die damit verbundenen vergangenen Ausgaben und Einnahmen werden aufbewahrt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο λογαριασμός θα αφαιρεθεί από τις λίστες σας. Τα προηγούμενα έξοδα και τα έσοδα που συνδέονται με αυτό διατηρούνται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account will be removed from your lists. Past expenses and income linked to it are kept."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account will be removed from your lists. Past expenses and income linked to it are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cuenta será eliminada de sus listas. Se mantienen los gastos pasados ​​y los ingresos vinculados a ellos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto eemaldatakse teie loenditest. Varasemad kulud ja nendega seotud tulud säilitatakse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tili poistetaan luetteloistasi. Aiemmat kulut ja niihin liittyvät tulot säilytetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le compte sera supprimé de vos listes. Les dépenses passées et les revenus qui y sont liés sont conservés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाता आपकी सूचियों से हटा दिया जाएगा. पिछले खर्चों और उससे जुड़ी आय को रखा जाता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun će biti uklonjen s vaših popisa. Čuvaju se prošli rashodi i prihodi vezani uz to."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fiókot eltávolítjuk a listákról. A múltbeli kiadások és az ehhez kapcsolódó bevételek megtartásra kerülnek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'account verrà rimosso dai tuoi elenchi. Le spese e le entrate passate ad esse collegate vengono mantenute."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paskyra bus pašalinta iš jūsų sąrašų. Išsaugomos ankstesnės išlaidos ir su jomis susijusios pajamos."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konts tiks noņemts no jūsu sarakstiem. Iepriekšējie izdevumi un ar tiem saistītie ienākumi tiek saglabāti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het account wordt uit uw lijsten verwijderd. Uitgaven uit het verleden en daaraan gekoppelde inkomsten blijven behouden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto zostanie usunięte z Twoich list. Utrzymuje się dotychczasowe wydatki i dochody z nimi związane."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta será removida das suas listas. As despesas e receitas antigas associadas são mantidas."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta será removida das suas listas. As despesas e receitas antigas associadas são mantidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta será removida das suas listas. As despesas e receitas antigas associadas são mantidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contul va fi eliminat din listele dvs. Cheltuielile și veniturile anterioare legate de acesta sunt păstrate."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Účet bude odstránený z vašich zoznamov. Minulé výdavky a príjmy s tým spojené sa uchovávajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Račun bo odstranjen z vaših seznamov. Hranijo se pretekli odhodki in z njimi povezani prihodki."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontot kommer att tas bort från dina listor. Tidigare utgifter och intäkter kopplade till det behålls."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该帐户将从您的列表中删除。过去的支出和与之相关的收入都被保留。"
          }
        }
      }
    },

    "accountsPage.empty.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your bank, cash, savings, or card accounts to track balances."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your bank, cash, savings, or card accounts to track balances."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione as suas contas bancárias, dinheiro, poupanças ou cartões para acompanhar saldos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione suas contas bancárias, dinheiro, poupanças ou cartões para acompanhar saldos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione as suas contas bancárias, dinheiro, poupanças ou cartões para acompanhar saldos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue sus cuentas bancarias, de efectivo, de ahorros o de tarjetas para realizar un seguimiento de los saldos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos comptes bancaires, de trésorerie, d'épargne ou de carte pour suivre les soldes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i tuoi conti bancari, contanti, di risparmio o carte per tenere traccia dei saldi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg uw bank-, contant geld-, spaar- of kaartrekeningen toe om uw saldo bij te houden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε τραπεζικούς λογαριασμούς, μετρητά, ταμιευτήριο ή λογαριασμούς κάρτας για να παρακολουθείτε τα υπόλοιπα."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte bankovni, gotovinski, štedni ili kartični račun da biste pratili stanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till dina bank-, kontant-, spar- eller kortkonton för att spåra saldon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Ihre Bank-, Bargeld-, Spar- oder Kartenkonten hinzu, um den Kontostand zu verfolgen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете вашите банкови, парични, спестовни или картови сметки, за да проследявате салда."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte své bankovní, hotovostní, spořící nebo kartové účty a sledujte zůstatky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj dine bank-, kontant-, opsparings- eller kortkonti for at spore saldi."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldode jälgimiseks lisage oma panga-, sularaha-, säästu- või kaardikontod."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää pankki-, käteis-, säästö- tai korttitilisi saldon seuraamiseen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja hozzá bank-, készpénz-, takarék- vagy kártyaszámláit az egyenlegek nyomon követéséhez."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet savus bankas, skaidras naudas, krājkontus vai kartes kontus, lai izsekotu atlikumiem."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami stebėti likučius, pridėkite savo banko, grynųjų pinigų, taupomųjų ar kortelių sąskaitas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj swoje konto bankowe, gotówkowe, oszczędnościowe lub karty, aby śledzić salda."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați conturile bancare, de numerar, de economii sau de card pentru a urmări soldurile."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte svoje bankové, hotovostné, sporiace alebo kartové účty na sledovanie zostatkov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte svoje bančne, gotovinske, varčevalne ali kartične račune za spremljanje stanja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加您的银行、现金、储蓄或卡帐户以跟踪余额。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेष राशि ट्रैक करने के लिए अपना बैंक, नकद, बचत या कार्ड खाता जोड़ें।"
          }
        }
      }
    },

          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakování je pozastaveno. Zapněte, chcete-li znovu naplánovat budoucí vklady."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gentagelse er sat på pause. Slå til for at planlægge fremtidige indbetalinger igen."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Kordumine on peatatud. Tulevaste sissemaksete ajastamiseks lülitage see sisse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toistuminen on keskeytetty. Kytke päälle ajoittaaksesi tulevat talletukset uudelleen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az ismétlődés szünetel. Kapcsolja be a jövőbeli befizetések ütemezéséhez."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atkārtošanās ir apturēta. Ieslēdziet, lai atkal ieplānotu turpmākos noguldījumus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasikartojimas pristabdytas. Įjunkite, kad vėl suplanuotumėte būsimus indėlius."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtarzanie jest wstrzymane. Włącz, aby ponownie zaplanować przyszłe wpłaty."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurența este întreruptă. Activați pentru a programa din nou depuneri viitoare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakovanie je pozastavené. Zapnite, ak chcete znova naplánovať budúce vklady."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponavljanje je zaustavljeno. Vklopite za ponoven razpored prihodnjih depozitov."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复发已暂停。再次打开以安排未来的存款。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनरावृत्ति रोक दी गई है. भविष्य की जमाओं को फिर से शेड्यूल करने के लिए चालू करें।"
          }
        }
      }
    },

            "state": "translated",
            "value": "Αυτή η καταχώριση εισοδήματος θα αφαιρεθεί. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj unos prihoda bit će uklonjen. Ovo se ne može poništiti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna inkomstpost kommer att tas bort. Detta kan inte ångras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Einkommenseintrag wird entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този запис на дохода ще бъде премахнат. Това не може да бъде отменено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento záznam o příjmu bude odstraněn. Toto nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne indkomstpostering vil blive fjernet. Dette kan ikke fortrydes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See sissetuleku kanne eemaldatakse. Seda ei saa tagasi võtta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä tulomerkintä poistetaan. Tätä ei voi kumota."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a bevételi bejegyzés törlésre kerül. Ezt nem lehet visszavonni."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis ienākumu ieraksts tiks noņemts. Šo darbību nevar atsaukt."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šis pajamų įrašas bus pašalintas. To negalima anuliuoti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten wpis dotyczący dochodu zostanie usunięty. Tego nie można cofnąć."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această intrare de venit va fi eliminată. Acest lucru nu poate fi anulat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento záznam príjmu bude odstránený. Toto sa nedá vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vnos dohodka bo odstranjen. Tega ni mogoče razveljaviti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此收入条目将被删除。此操作无法撤消。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आय प्रविष्टि हटा दी जाएगी. इसे असंपादित नहीं किया जा सकता है।"
          }
        }
      }
    },

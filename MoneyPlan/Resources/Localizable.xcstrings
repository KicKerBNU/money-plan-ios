    "auth.login.legal": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing you agree to Money Plan's Terms and Privacy Policy."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "By continuing you agree to Money Plan's Terms and Privacy Policy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, aceita os Termos e a Política de Privacidade do Money Plan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, aceita os Termos e a Política de Privacidade do Money Plan."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, aceita os Termos e a Política de Privacidade do Money Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, acepta los términos y la política de privacidad de Money Plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez les conditions et la politique de confidentialité de Money Plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando accetti i Termini e l'Informativa sulla privacy del Money Plan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als u doorgaat, gaat u akkoord met de voorwaarden en het privacybeleid van Money Plan."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίζοντας, συμφωνείτε με τους Όρους και την Πολιτική Απορρήτου του Money Plan."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ako nastavite, slažete se s Uvjetima i Politikom privatnosti Money Plana."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genom att fortsätta godkänner du Money Plans villkor och sekretesspolicy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indem Sie fortfahren, stimmen Sie den Geschäftsbedingungen und der Datenschutzrichtlinie von Money Plan zu."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Продължавайки, вие се съгласявате с условията и политиката за поверителност на Money Plan."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračováním souhlasíte s podmínkami a zásadami ochrany osobních údajů Money Plan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ved at fortsætte accepterer du Money Plans vilkår og privatlivspolitik."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Jätkates nõustute Money Plani tingimuste ja privaatsuspoliitikaga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jatkamalla hyväksyt Money Planin ehdot ja tietosuojakäytännön."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A folytatással elfogadja a Money Plan feltételeit és adatvédelmi szabályzatát."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Turpinot jūs piekrītat Money Plan noteikumiem un konfidencialitātes politikai."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tęsdami sutinkate su Pinigų plano sąlygomis ir privatumo politika."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuując, wyrażasz zgodę na Warunki planu pieniężnego i Politykę prywatności."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuând, sunteți de acord cu Termenii și Politica de confidențialitate a Planului Money."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokračovaním súhlasíte s podmienkami a zásadami ochrany osobných údajov programu Money."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z nadaljevanjem se strinjate s pogoji in politiko zasebnosti denarnega načrta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即表示您同意 Money Plan 的条款和隐私政策。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखकर आप मनी प्लान की शर्तों और गोपनीयता नीति से सहमत हैं।"
          }
        }
      }
    },

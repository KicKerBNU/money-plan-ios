    "chatbot.consent.whatBody": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chat messages, recent messages in this conversation, and expense records from your account that are needed to answer your question (for example totals, categories, or expense lines for a date range you ask about)."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Your chat messages, recent messages in this conversation, and expense records from your account that are needed to answer your question (for example totals, categories, or expense lines for a date range you ask about)."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas mensagens no chat, mensagens recentes desta conversa e registros de despesas da sua conta necessários para responder (por exemplo totais, categorias ou lançamentos em um período que você pedir)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas mensagens no chat, mensagens recentes desta conversa e registros de despesas da sua conta necessários para responder (por exemplo totais, categorias ou lançamentos em um período que você pedir)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas mensagens no chat, mensagens recentes desta conversa e registos de despesas da sua conta necessários para responder (por exemplo totais, categorias ou lançamentos num período que pedir)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus mensajes de chat, mensajes recientes en esta conversación y registros de gastos de su cuenta que son necesarios para responder su pregunta (por ejemplo, totales, categorías o líneas de gastos para un rango de fechas sobre el que pregunta)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos messages de discussion, les messages récents de cette conversation et les enregistrements de dépenses de votre compte qui sont nécessaires pour répondre à votre question (par exemple les totaux, les catégories ou les lignes de dépenses pour une plage de dates sur laquelle vous posez une question)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi messaggi di chat, i messaggi recenti di questa conversazione e i record di spesa del tuo account necessari per rispondere alla tua domanda (ad esempio totali, categorie o linee di spesa per un intervallo di date di cui hai chiesto)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw chatberichten, recente berichten in dit gesprek en onkostengegevens uit uw account die nodig zijn om uw vraag te beantwoorden (bijvoorbeeld totalen, categorieën of onkostenregels voor een periode waarnaar u vraagt)."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μηνύματά σας συνομιλίας, τα πρόσφατα μηνύματα σε αυτήν τη συνομιλία και τα αρχεία εξόδων από τον λογαριασμό σας που απαιτούνται για την απάντηση στην ερώτησή σας (για παράδειγμα σύνολα, κατηγορίες ή γραμμές εξόδων για ένα εύρος ημερομηνιών για το οποίο ρωτάτε)."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše poruke chata, nedavne poruke u ovom razgovoru i zapisi o troškovima s vašeg računa koji su potrebni za odgovor na vaše pitanje (na primjer ukupni iznosi, kategorije ili linije troškova za razdoblje o kojem pitate)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina chattmeddelanden, senaste meddelanden i den här konversationen och utgiftsposter från ditt konto som behövs för att svara på din fråga (till exempel summor, kategorier eller utgiftsrader för ett datumintervall du frågar om)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Chat-Nachrichten, aktuelle Nachrichten in dieser Konversation und Spesendatensätze aus Ihrem Konto, die zur Beantwortung Ihrer Frage benötigt werden (z. B. Summen, Kategorien oder Spesenzeilen für einen Datumsbereich, nach dem Sie fragen)."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите съобщения в чата, скорошни съобщения в този разговор и записи за разходи от вашия акаунт, които са необходими, за да отговорите на вашия въпрос (например общи суми, категории или редове за разходи за период от време, за който питате)."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše chatovací zprávy, nedávné zprávy v této konverzaci a záznamy o výdajích z vašeho účtu, které jsou potřeba k zodpovězení vaší otázky (například součty, kategorie nebo výdajové řádky pro časové období, na které se ptáte)."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine chatbeskeder, seneste beskeder i denne samtale og udgiftsposter fra din konto, som er nødvendige for at besvare dit spørgsmål (f.eks. totaler, kategorier eller udgiftslinjer for et datointerval, du spørger om)."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Teie vestlussõnumid, selle vestluse hiljutised sõnumid ja teie konto kulukirjed, mida on vaja teie küsimusele vastamiseks (nt kogusummad, kategooriad või kuluread kuupäevavahemiku kohta, mille kohta küsite)."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat-viestisi, tämän keskustelun viimeisimmät viestit ja tilisi kulutiedot, joita tarvitaan kysymykseesi vastaamiseen (esimerkiksi kokonaissummat, luokat tai kulurivit kysymäsi ajanjakson osalta)."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Ön csevegőüzenetei, a beszélgetésben a legutóbbi üzenetek és a fiókjából származó költségnyilvántartások, amelyekre szükség van a kérdés megválaszolásához (például összegek, kategóriák vagy költségsorok egy adott dátumtartományhoz, amelyre vonatkozóan kérdezett)."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsu tērzēšanas ziņojumi, jaunākie ziņojumi šajā sarunā un jūsu konta izdevumu ieraksti, kas nepieciešami, lai atbildētu uz jūsu jautājumu (piemēram, kopsummas, kategorijas vai izdevumu rindas datumu diapazonam, par kuru uzdodat jautājumu)."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Jūsų pokalbių pranešimai, naujausi šio pokalbio pranešimai ir paskyros išlaidų įrašai, kurių reikia norint atsakyti į jūsų klausimą (pavyzdžiui, sumos, kategorijos arba išlaidų eilutės tos dienų sekos, apie kurią klausiate)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wiadomości na czacie, ostatnie wiadomości w tej rozmowie i zapisy wydatków z Twojego konta potrzebne do udzielenia odpowiedzi na Twoje pytanie (na przykład sumy, kategorie lub pozycje wydatków dla zakresu dat, o który pytasz)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajele dvs. de chat, mesajele recente din această conversație și înregistrările de cheltuieli din contul dvs. care sunt necesare pentru a răspunde la întrebarea dvs. (de exemplu, totaluri, categorii sau linii de cheltuieli pentru un interval de date despre care întrebați)."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše chatové správy, posledné správy v tejto konverzácii a záznamy o výdavkoch z vášho účtu, ktoré sú potrebné na zodpovedanie vašej otázky (napríklad súčty, kategórie alebo výdavkové riadky pre rozsah dátumov, na ktorý sa pýtate)."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša sporočila v klepetu, nedavna sporočila v tem pogovoru in zapisi stroškov iz vašega računa, ki so potrebni za odgovor na vaše vprašanje (na primer vsote, kategorije ali vrstice stroškov za časovno obdobje, o katerem sprašujete)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的聊天消息、此对话中的最新消息以及回答您的问题所需的帐户中的费用记录（例如您询问的日期范围内的总计、类别或费用行）。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चैट संदेश, इस वार्तालाप में हाल के संदेश, और आपके खाते से व्यय रिकॉर्ड जो आपके प्रश्न का उत्तर देने के लिए आवश्यक हैं (उदाहरण के लिए आपके द्वारा पूछे जाने वाली तिथि सीमा के लिए कुल योग, श्रेणियां या व्यय रेखाएं)।"
          }
        }
      }
    },

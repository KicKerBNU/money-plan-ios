    "recurringIncome.confirmDelete.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the recurring template. Existing income entries are kept."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the recurring template. Existing income entries are kept."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o modelo recorrente. As receitas existentes são mantidas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o modelo recorrente. As receitas existentes são mantidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o modelo recorrente. As receitas existentes são mantidas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la plantilla recurrente. Se mantienen las entradas de ingresos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le modèle récurrent. Les entrées de revenus existantes sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo rimuove il modello ricorrente. Le voci di reddito esistenti vengono mantenute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt de terugkerende sjabloon verwijderd. Bestaande inkomensvermeldingen blijven behouden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό καταργεί το επαναλαμβανόμενο πρότυπο. Οι υπάρχουσες εγγραφές εισοδήματος τηρούνται."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Time se uklanja predložak koji se ponavlja. Postojeća knjiženja prihoda se čuvaju."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort den återkommande mallen. Befintliga inkomstposter behålls."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die wiederkehrende Vorlage entfernt. Vorhandene Einkommenseinträge bleiben erhalten."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това премахва повтарящия се шаблон. Съществуващите записи за приходи се запазват."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se odstraní opakující se šablona. Stávající příjmové položky jsou zachovány."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner den tilbagevendende skabelon. Eksisterende indkomstposteringer bevares."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See eemaldab korduva malli. Olemasolevad tulukanded säilitatakse."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa toistuvan mallin. Olemassa olevat tulotiedot säilytetään."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel eltávolítja az ismétlődő sablont. A meglévő bevételi bejegyzések megmaradnak."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tādējādi tiek noņemta atkārtotā veidne. Esošie ienākumu ieraksti tiek saglabāti."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai pašalina pasikartojantį šabloną. Saugomi esami pajamų įrašai."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie szablonu cyklicznego. Istniejące zapisy dotyczące dochodów zostają zachowane."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru elimină șablonul recurent. Se păstrează înregistrările existente ale veniturilor."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Tým sa odstráni opakujúca sa šablóna. Existujúce záznamy o príjmoch sa zachovajú."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem odstranite ponavljajočo se predlogo. Obstoječi vpisi prihodkov se ohranijo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除重复模板。保留现有收入条目。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आवर्ती टेम्पलेट को हटा देता है. मौजूदा आय प्रविष्टियाँ रखी जाती हैं।"
          }
        }
      }
    },

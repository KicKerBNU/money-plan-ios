    "income.empty.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add salary, freelance payments, rent, or any other money coming in."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Add salary, freelance payments, rent, or any other money coming in."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione salário, freelances, aluguel ou qualquer outra entrada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione salário, freelances, aluguel ou qualquer outra entrada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione salário, freelances, aluguel ou qualquer outra entrada."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregue salario, pagos de autónomos, alquiler o cualquier otro dinero que ingrese."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le salaire, les paiements d'indépendant, le loyer ou tout autre argent entrant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi lo stipendio, i pagamenti del freelance, l'affitto o qualsiasi altro denaro in entrata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg salaris, freelancebetalingen, huur of ander binnenkomend geld toe."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προσθέστε μισθό, πληρωμές ανεξάρτητων επαγγελματιών, ενοίκιο ή οποιαδήποτε άλλα χρήματα εισέρχονται."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte plaću, honorarne isplate, stanarinu ili bilo koji drugi novac koji pristiže."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till lön, frilansbetalningar, hyra eller andra pengar som kommer in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Gehalt, freiberufliche Zahlungen, Miete oder andere eingehende Gelder hinzu."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете заплата, плащания на свободна практика, наем или други постъпващи пари."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidejte plat, platby na volné noze, nájemné nebo jakékoli další přicházející peníze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj løn, freelancebetalinger, husleje eller andre penge, der kommer ind."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisage palk, vabakutselised maksed, üür või muu laekuva raha."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisää palkka, freelance-maksut, vuokra tai mikä tahansa muu saapuva raha."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adja hozzá a fizetést, a szabadúszó kifizetéseket, a bérleti díjat vagy bármilyen más beérkező pénzt."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pievienojiet algu, ārštata maksājumus, īri vai jebkuru citu ienākošo naudu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridėkite atlyginimą, laisvai samdomus mokėjimus, nuomą ar bet kokius kitus gaunamus pinigus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj wynagrodzenie, płatności zewnętrzne, czynsz lub inne wpływy pieniężne."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adăugați salariu, plăți pentru independenți, chirie sau orice alți bani care vin."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pridajte plat, platby na voľnej nohe, nájomné alebo akékoľvek iné prichádzajúce peniaze."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodajte plačo, samostojna plačila, najemnino ali kateri koli drug denar, ki prihaja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加工资、自由职业付款、租金或任何其他收入。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वेतन, फ्रीलांस भुगतान, किराया, या आने वाला कोई अन्य पैसा जोड़ें।"
          }
        }
      }
    },

            "state": "translated",
            "value": "Súhlaste a pokračujte"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strinjajte se in nadaljujte"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同意并继续"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहमत हों और जारी रखें"
          }
        }
      }
    },
    "chatbot.consent.bannerBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use Chat, you must agree to send your messages and relevant expense data to OpenAI via our servers. See details in the prompt or our Privacy Policy."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "To use Chat, you must agree to send your messages and relevant expense data to OpenAI via our servers. See details in the prompt or our Privacy Policy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o Chat, você precisa concordar em enviar suas mensagens e dados de despesas relevantes à OpenAI pelos nossos servidores. Veja os detalhes no aviso ou na Política de Privacidade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o Chat, você precisa concordar em enviar suas mensagens e dados de despesas relevantes à OpenAI pelos nossos servidores. Veja os detalhes no aviso ou na Política de Privacidade."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar o Chat, tem de concordar em enviar as suas mensagens e dados de despesas relevantes à OpenAI através dos nossos servidores. Veja os detalhes no aviso ou na Política de Privacidade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para utilizar Chat, debe aceptar enviar sus mensajes y datos de gastos relevantes a OpenAI a través de nuestros servidores. Vea los detalles en el aviso o en nuestra Política de Privacidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser Chat, vous devez accepter d'envoyer vos messages et vos données de dépenses pertinentes à OpenAI via nos serveurs. Voir les détails dans l’invite ou dans notre politique de confidentialité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per utilizzare la Chat, devi accettare di inviare i tuoi messaggi e i dati di spesa rilevanti a OpenAI tramite i nostri server. Vedi i dettagli nel messaggio o nella nostra Informativa sulla privacy."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om Chat te gebruiken, moet u ermee akkoord gaan dat uw berichten en relevante onkostengegevens via onze servers naar OpenAI worden verzonden. Zie de details in de prompt of in ons privacybeleid."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Για να χρησιμοποιήσετε το Chat, πρέπει να συμφωνήσετε να στείλετε τα μηνύματά σας και τα σχετικά δεδομένα εξόδων στο OpenAI μέσω των διακομιστών μας. Δείτε λεπτομέρειες στο μήνυμα προτροπής ή στην Πολιτική απορρήτου μας."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Da biste koristili Chat, morate pristati na slanje svojih poruka i relevantnih podataka o troškovima OpenAI-ju putem naših poslužitelja. Pogledajte detalje u upitu ili u našim Pravilima privatnosti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att använda Chat måste du godkänna att skicka dina meddelanden och relevant kostnadsdata till OpenAI via våra servrar. Se detaljer i meddelandet eller vår integritetspolicy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um den Chat nutzen zu können, müssen Sie zustimmen, Ihre Nachrichten und relevanten Ausgabendaten über unsere Server an OpenAI zu senden. Weitere Informationen finden Sie in der Eingabeaufforderung oder in unserer Datenschutzerklärung."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "За да използвате чат, трябва да се съгласите да изпращате вашите съобщения и съответните данни за разходите до OpenAI чрез нашите сървъри. Вижте подробности в подканата или нашата Политика за поверителност."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Chcete-li používat Chat, musíte souhlasit se zasíláním vašich zpráv a příslušných údajů o výdajích do OpenAI prostřednictvím našich serverů. Podrobnosti naleznete ve výzvě nebo v našich Zásadách ochrany osobních údajů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at bruge Chat skal du acceptere at sende dine beskeder og relevante udgiftsdata til OpenAI via vores servere. Se detaljerne i prompten eller vores privatlivspolitik."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Chati kasutamiseks peate nõustuma oma sõnumite ja asjakohaste kuluandmete saatmisega OpenAI-le meie serverite kaudu. Vaadake üksikasju viipast või meie privaatsuspoliitikast."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käyttääksesi Chatia sinun on suostuttava lähettämään viestisi ja asiaankuuluvat kulutietosi OpenAI:lle palvelimiemme kautta. Katso yksityiskohdat kehotteesta tai tietosuojakäytännöstämme."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Chat használatához el kell fogadnia, hogy üzeneteit és vonatkozó költségadatait szervereinken keresztül elküldi az OpenAI-nak. Tekintse meg a részleteket a felszólításban vagy az Adatvédelmi szabályzatunkban."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lai izmantotu tērzēšanu, jums ir jāpiekrīt sūtīt savus ziņojumus un attiecīgos izdevumu datus OpenAI caur mūsu serveriem. Skatiet sīkāku informāciju uzvednē vai mūsu konfidencialitātes politikā."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Norėdami naudotis pokalbių programa, turite sutikti siųsti savo pranešimus ir susijusius išlaidų duomenis į OpenAI per mūsų serverius. See details in the prompt or our Privacy Policy."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby korzystać z Czatu, musisz wyrazić zgodę na wysyłanie wiadomości i odpowiednich danych o wydatkach do OpenAI za pośrednictwem naszych serwerów. Zobacz szczegóły w monicie lub w naszej Polityce prywatności."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pentru a utiliza Chat, trebuie să fiți de acord să trimiteți mesajele și datele relevante despre cheltuieli către OpenAI prin serverele noastre. Vedeți detalii în prompt sau în Politica noastră de confidențialitate."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak chcete používať Chat, musíte súhlasiť s odosielaním vašich správ a príslušných údajov o výdavkoch do OpenAI prostredníctvom našich serverov. Podrobnosti nájdete vo výzve alebo v našich Zásadách ochrany osobných údajov."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če želite uporabljati klepet, se morate strinjati s pošiljanjem vaših sporočil in ustreznih podatkov o stroških OpenAI prek naših strežnikov. Oglejte si podrobnosti v pozivu ali našem pravilniku o zasebnosti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要使用聊天，您必须同意通过我们的服务器将您的消息和相关费用数据发送给 OpenAI。请参阅提示或我们的隐私政策中的详细信息。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट का उपयोग करने के लिए, आपको हमारे सर्वर के माध्यम से अपने संदेश और प्रासंगिक व्यय डेटा OpenAI को भेजने के लिए सहमत होना होगा। प्रॉम्प्ट या हमारी गोपनीयता नीति में विवरण देखें।"
          }
        }
      }
    },

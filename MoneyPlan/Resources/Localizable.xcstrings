    "recurring.form.stopRecurrenceHint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off recurring expense to stop future repeats."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off recurring expense to stop future repeats."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue despesa recorrente para parar repetições futuras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue despesa recorrente para parar repetições futuras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue despesa recorrente para parar repetições futuras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactive los gastos recurrentes para evitar repeticiones futuras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez les dépenses récurrentes pour arrêter les répétitions futures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva le spese ricorrenti per evitare ripetizioni future."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel terugkerende uitgaven uit om toekomstige herhalingen te voorkomen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε τις επαναλαμβανόμενες δαπάνες για να σταματήσετε τις μελλοντικές επαναλήψεις."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključite ponavljajuće troškove kako biste zaustavili buduća ponavljanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av återkommande utgifter för att stoppa framtida upprepningar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktivieren Sie wiederkehrende Ausgaben, um zukünftige Wiederholungen zu verhindern."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключете повтарящите се разходи, за да спрете бъдещите повторения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypněte opakující se výdaje, abyste zastavili budoucí opakování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå tilbagevendende udgifter fra for at stoppe fremtidige gentagelser."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulevaste korduste peatamiseks lülitage korduvad kulud välja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista toistuvat kulut käytöstä estääksesi tulevat toistot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja ki az ismétlődő kiadásokat a jövőbeni ismétlődések leállításához."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izslēdziet periodiskos izdevumus, lai apturētu atkārtošanos nākotnē."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Išjunkite pasikartojančias išlaidas, kad ateityje nebepasikartotų."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz powtarzające się wydatki, aby zapobiec ich powtarzaniu się w przyszłości."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivați cheltuielile recurente pentru a opri repetările viitoare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite opakujúce sa výdavky, aby ste zastavili budúce opakovania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izklopite ponavljajoče se stroške, da preprečite prihodnja ponavljanja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭经常性费用以防止未来重复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भविष्य में पुनरावृत्ति रोकने के लिए आवर्ती व्यय बंद करें।"
          }
        }
      }
    },

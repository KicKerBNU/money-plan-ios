          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera en utgift som återkommande när du lägger till den, eller skapa en på fliken Lägg till."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie eine Ausgabe als wiederkehrend, wenn Sie sie hinzufügen, oder erstellen Sie eine Ausgabe über die Registerkarte „Hinzufügen“."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маркирайте разход като повтарящ се, когато го добавяте, или създайте такъв от раздела Добавяне."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte výdaj jako opakující se při jeho přidání nebo jej vytvořte na kartě Přidat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker en udgift som tilbagevendende, når du tilføjer den, eller opret en fra fanen Tilføj."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkige kulu lisamisel korduvaks või looge see vahekaardil Lisa."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse kulu toistuvaksi, kun lisäät sen, tai luo se Lisää-välilehdellä."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölje meg a kiadást ismétlődőként, amikor hozzáadja, vagy hozzon létre egyet a Hozzáadás lapon."

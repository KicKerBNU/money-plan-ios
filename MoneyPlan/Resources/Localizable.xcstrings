    "chatbot.consent.whoBody": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI processes this data on our behalf through our backend API to generate replies. OpenAI does not receive your password or unrelated app data."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI processes this data on our behalf through our backend API to generate replies. OpenAI does not receive your password or unrelated app data."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A OpenAI processa esses dados em nosso nome pela nossa API para gerar respostas. A OpenAI não recebe sua senha nem outros dados do app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A OpenAI processa esses dados em nosso nome pela nossa API para gerar respostas. A OpenAI não recebe sua senha nem outros dados do app."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A OpenAI processa estes dados em nosso nome através da nossa API para gerar respostas. A OpenAI não recebe a sua palavra-passe nem outros dados da app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI procesa estos datos en nuestro nombre a través de nuestra API backend para generar respuestas. OpenAI no recibe su contraseña ni datos de aplicaciones no relacionadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI traite ces données en notre nom via notre API backend pour générer des réponses. OpenAI ne reçoit pas votre mot de passe ni les données d'application non liées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI elabora questi dati per nostro conto tramite la nostra API backend per generare risposte. OpenAI non riceve la tua password o i dati delle app non correlate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI verwerkt deze gegevens namens ons via onze backend API om antwoorden te genereren. OpenAI ontvangt uw wachtwoord of niet-gerelateerde app-gegevens niet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το OpenAI επεξεργάζεται αυτά τα δεδομένα για λογαριασμό μας μέσω του backend API μας για να δημιουργήσει απαντήσεις. Το OpenAI δεν λαμβάνει τον κωδικό πρόσβασής σας ή τα άσχετα δεδομένα εφαρμογής."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI obrađuje ove podatke u naše ime putem našeg pozadinskog API-ja za generiranje odgovora. OpenAI ne prima vašu lozinku ili nepovezane podatke aplikacije."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI bearbetar dessa data för vår räkning genom vårt backend-API för att generera svar. OpenAI tar inte emot ditt lösenord eller orelaterade appdata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI verarbeitet diese Daten in unserem Auftrag über unsere Backend-API, um Antworten zu generieren. OpenAI erhält weder Ihr Passwort noch damit zusammenhängende App-Daten."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI обработва тези данни от наше име чрез нашия backend API, за да генерира отговори. OpenAI не получава вашата парола или несвързани данни от приложения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI zpracovává tato data naším jménem prostřednictvím našeho backendového API za účelem generování odpovědí. OpenAI neobdrží vaše heslo ani nesouvisející data aplikací."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI behandler disse data på vores vegne gennem vores backend API for at generere svar. OpenAI modtager ikke din adgangskode eller urelaterede appdata."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI töötleb neid andmeid meie nimel meie taustarakenduse API kaudu vastuste genereerimiseks. OpenAI ei saa teie parooli ega seotud rakenduse andmeid."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI käsittelee näitä tietoja puolestamme taustasovellusliittymämme kautta vastausten luomiseksi. OpenAI ei saa salasanaasi tai asiaankuulumattomia sovellustietojasi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az OpenAI ezeket az adatokat a nevünkben dolgozza fel a háttér API-n keresztül a válaszok generálásához. Az OpenAI nem kapja meg jelszavát vagy nem kapcsolódó alkalmazásadatait."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI apstrādā šos datus mūsu vārdā, izmantojot mūsu aizmugursistēmas API, lai ģenerētu atbildes. OpenAI nesaņem jūsu paroli vai nesaistītus lietotņu datus."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI apdoroja šiuos duomenis mūsų vardu per mūsų užpakalinės programos API, kad generuotų atsakymus. OpenAI negauna jūsų slaptažodžio ar nesusijusių programos duomenų."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI przetwarza te dane w naszym imieniu za pośrednictwem naszego interfejsu API zaplecza w celu generowania odpowiedzi. OpenAI nie otrzymuje Twojego hasła ani niepowiązanych danych aplikacji."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI procesează aceste date în numele nostru prin API-ul nostru backend pentru a genera răspunsuri. OpenAI nu primește parola dvs. sau datele aplicației care nu au legătură."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI spracováva tieto údaje v našom mene prostredníctvom nášho backendového API na generovanie odpovedí. OpenAI nedostáva vaše heslo ani nesúvisiace údaje aplikácie."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI obdeluje te podatke v našem imenu prek našega zalednega API-ja za ustvarjanje odgovorov. OpenAI ne prejme vašega gesla ali nepovezanih podatkov aplikacije."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI 通过我们的后端 API 代表我们处理这些数据以生成回复。 OpenAI 不会接收您的密码或无关的应用程序数据。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ओपनएआई उत्तर उत्पन्न करने के लिए हमारे बैकएंड एपीआई के माध्यम से हमारी ओर से इस डेटा को संसाधित करता है। OpenAI को आपका पासवर्ड या असंबंधित ऐप डेटा प्राप्त नहीं होता है।"
          }
        }
      }
    },

        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός είναι ο προεπιλεγμένος λογαριασμός σας. Ορίστε έναν άλλο λογαριασμό ως προεπιλογή για να τον αλλάξετε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is your default account. Set another account as default to change it."

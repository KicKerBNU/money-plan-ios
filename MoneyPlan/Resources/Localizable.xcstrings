    "auth.deleteAccount.confirmBody": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your Money Plan account, all expenses, income, accounts, and categories. This cannot be undone."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes your Money Plan account, all expenses, income, accounts, and categories. This cannot be undone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta Money Plan, todas as despesas, receitas, contas e categorias. Não dá para desfazer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta Money Plan, todas as despesas, receitas, contas e categorias. Não dá para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto elimina permanentemente a sua conta Money Plan, todas as despesas, receitas, contas e categorias. Não pode ser anulado."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente su cuenta de Money Plan, todos los gastos, ingresos, cuentas y categorías. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement votre compte Money Plan, toutes les dépenses, revenus, comptes et catégories. Cela ne peut pas être annulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò eliminerà permanentemente il tuo account Money Plan, tutte le spese, le entrate, i conti e le categorie. Questa operazione non può essere annullata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden uw Money Plan-account, alle uitgaven, inkomsten, accounts en categorieën permanent verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει οριστικά τον λογαριασμό σας στο Money Plan, όλα τα έξοδα, τα έσοδα, τους λογαριασμούς και τις κατηγορίες. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo trajno briše vaš račun Money Plana, sve troškove, prihode, račune i kategorije. Ovo se ne može poništiti."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar permanent bort ditt Money Plan-konto, alla utgifter, inkomster, konton och kategorier. Detta kan inte ångras."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden Ihr Money Plan-Konto sowie alle Ausgaben, Einnahmen, Konten und Kategorien dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това изтрива за постоянно вашия акаунт в Money Plan, всички разходи, приходи, акаунти и категории. Това не може да бъде отменено."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tím se trvale odstraní váš účet Money Plan, všechny výdaje, příjmy, účty a kategorie. Toto nelze vrátit zpět."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette sletter permanent din Money Plan-konto, alle udgifter, indtægter, konti og kategorier. Dette kan ikke fortrydes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "See kustutab jäädavalt teie rahaplaani konto, kõik kulud, tulud, kontod ja kategooriad. Seda ei saa tagasi võtta."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä poistaa pysyvästi Money Plan -tilisi, kaikki kulut, tulot, tilit ja luokat. Tätä ei voi kumota."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezzel véglegesen törli Money Plan-fiókját, minden kiadást, bevételt, számlát és kategóriát. Ezt nem lehet visszavonni."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tādējādi tiek neatgriezeniski izdzēsts jūsu naudas plāna konts, visi izdevumi, ienākumi, konti un kategorijas. Šo darbību nevar atsaukt."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tai visam laikui ištrins jūsų Pinigų plano paskyrą, visas išlaidas, pajamas, sąskaitas ir kategorijas. To negalima anuliuoti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie Twojego konta Money Plan, wszystkich wydatków, dochodów, kont i kategorii. Tego nie można cofnąć."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru șterge definitiv contul dvs. de Money Plan, toate cheltuielile, veniturile, conturile și categoriile. Acest lucru nu poate fi anulat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto natrvalo odstráni váš účet Money Plan, všetky výdavky, príjmy, účty a kategórie. Toto sa nedá vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "S tem trajno izbrišete svoj račun denarnega načrta, vse stroške, prihodke, račune in kategorije. Tega ni mogoče razveljaviti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除您的理财计划帐户、所有费用、收入、帐户和类别。此操作无法撤消。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके मनी प्लान खाते, सभी खर्चों, आय, खातों और श्रेणियों को स्थायी रूप से हटा देता है। इसे असंपादित नहीं किया जा सकता है।"
          }
        }
      }
    },

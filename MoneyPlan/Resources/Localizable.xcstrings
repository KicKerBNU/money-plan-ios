    "auth.login.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to access your expenses, income, and expense assistant. All features require an account and your private data."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão para aceder às suas despesas, receitas e assistente de despesas. Todas as funcionalidades exigem conta e os seus dados privados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão para aceder às suas despesas, receitas e assistente de despesas. Todas as funcionalidades exigem conta e os seus dados privados."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to access your expenses, income, and expense assistant. All features require an account and your private data."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão para acessar suas despesas, receitas e assistente de despesas. Todos os recursos exigem conta e seus dados privados."

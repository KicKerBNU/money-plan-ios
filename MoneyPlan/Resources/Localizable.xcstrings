    "recurring.form.stopRecurrenceHint" : {
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изключете повтарящите се разходи, за да спрете бъдещите повторения."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vypněte opakující se výdaje, abyste zastavili budoucí opakování."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå tilbagevendende udgifter fra for at stoppe fremtidige gentagelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren Sie wiederkehrende Ausgaben, um zukünftige Wiederholungen zu verhindern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Απενεργοποιήστε τις επαναλαμβανόμενες δαπάνες για να σταματήσετε τις μελλοντικές επαναλήψεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off recurring expense to stop future repeats."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn off recurring expense to stop future repeats."
          }
        },
        "es" : {

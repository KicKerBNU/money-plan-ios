    "chatbot.consent.howBody" : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Само за да отговорим на вашите въпроси за разходите в Money Plan. Ние не използваме асистента за реклама или продажба на вашите данни."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pouze k zodpovězení vašich otázek ohledně výdajů v rámci Money Plan. Asistenta nepoužíváme k reklamě ani k prodeji vašich dat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kun for at besvare dine udgiftsspørgsmål i Money Plan. Vi bruger ikke assistenten til at annoncere eller sælge dine data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur zur Beantwortung Ihrer Spesenfragen in Money Plan. Wir nutzen den Assistenten nicht für Werbung oder verkaufen Ihre Daten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μόνο για να απαντήσετε στις ερωτήσεις εξόδων σας στο Money Plan. Δεν χρησιμοποιούμε τον βοηθό για διαφήμιση ή πώληση των δεδομένων σας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only to answer your expense questions inside Money Plan. We do not use the assistant for advertising or sell your data."
          }
        },
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only to answer your expense questions inside Money Plan. We do not use the assistant for advertising or sell your data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo para responder sus preguntas sobre gastos dentro de Money Plan. No utilizamos el asistente para publicidad ni vendemos sus datos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainult selleks, et vastata teie rahaplaanis olevatele kuluküsimustele. Me ei kasuta assistenti reklaamimiseks ega teie andmete müümiseks."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain vastataksesi kulukysymyksiisi Money Planin sisällä. Emme käytä avustajaa mainontaan tai tietojen myymiseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uniquement pour répondre à vos questions sur les dépenses dans Money Plan. Nous n'utilisons pas l'assistant à des fins publicitaires ni ne vendons vos données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल मनी प्लान के अंदर आपके व्यय संबंधी प्रश्नों का उत्तर देने के लिए। हम विज्ञापन के लिए या आपका डेटा बेचने के लिए सहायक का उपयोग नहीं करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo da odgovorim na vaša pitanja o troškovima unutar Money Plana. Pomoćnika ne koristimo za oglašavanje niti za prodaju vaših podataka."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a költségekkel kapcsolatos kérdések megválaszolásához a Money Plan-on belül. Az asszisztenst nem használjuk reklámozásra vagy adatainak értékesítésére."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo per rispondere alle tue domande sulle spese all'interno del Money Plan. Non utilizziamo l'assistente per pubblicizzare o vendere i tuoi dati."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik norėdami atsakyti į jūsų klausimus apie išlaidas pinigų plane. Mes nenaudojame asistento reklamai ir neparduodame jūsų duomenų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tikai, lai atbildētu uz jūsu jautājumiem par izdevumiem naudas plānā. Mēs neizmantojam palīgu reklamēšanai vai jūsu datu pārdošanai."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen om uw uitgavenvragen binnen Money Plan te beantwoorden. Wij gebruiken de assistent niet voor het adverteren of verkopen van uw gegevens."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tylko po to, aby odpowiedzieć na pytania dotyczące wydatków w ramach Money Plan. Nie wykorzystujemy asystenta do reklamy ani sprzedaży Twoich danych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente para responder perguntas sobre despesas dentro do Money Plan. Não usamos o assistente para anúncios nem vendemos seus dados."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente para responder perguntas sobre despesas dentro do Money Plan. Não usamos o assistente para anúncios nem vendemos seus dados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apenas para responder a perguntas sobre despesas dentro do Money Plan. Não usamos o assistente para publicidade nem vendemos os seus dados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar pentru a răspunde la întrebările dvs. privind cheltuielile din cadrul Planului de bani. Nu folosim asistentul pentru publicitate sau vindem datele dvs."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Len na zodpovedanie vašich otázok o výdavkoch v rámci Money Plan. Asistenta nepoužívame na reklamu ani na predaj vašich údajov."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samo za odgovor na vaša vprašanja o stroških znotraj denarnega načrta. Asistenta ne uporabljamo za oglaševanje ali prodajo vaših podatkov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endast för att svara på dina utgiftsfrågor inom Money Plan. Vi använder inte assistenten för att annonsera eller sälja dina uppgifter."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅回答您在理财计划中的费用问题。我们不会使用该助手进行广告或出售您的数据。"
          }
        }
      }
    },

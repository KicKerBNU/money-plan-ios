    "auth.login.resetDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll email you a link to set a new password. Make sure your address is the one you signed up with."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll email you a link to set a new password. Make sure your address is the one you signed up with."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um e-mail com um link para definir uma nova palavra-passe. Confirme que o endereço é o que usou no registo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um e-mail com um link para definir uma nova palavra-passe. Confirme que o endereço é o que usou no registo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos um e-mail com um link para definir uma nova palavra-passe. Confirme que o endereço é o que usou no registo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le enviaremos por correo electrónico un enlace para establecer una nueva contraseña. Asegúrate de que tu dirección sea aquella con la que te registraste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous enverrons par e-mail un lien pour définir un nouveau mot de passe. Assurez-vous que votre adresse est celle avec laquelle vous vous êtes inscrit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti invieremo via email un collegamento per impostare una nuova password. Assicurati che il tuo indirizzo sia quello con cui ti sei registrato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We sturen u per e-mail een link waarmee u een nieuw wachtwoord kunt instellen. Zorg ervoor dat uw adres hetzelfde is als waarmee u zich heeft aangemeld."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα σας στείλουμε με email έναν σύνδεσμο για να ορίσετε νέο κωδικό πρόσβασης. Βεβαιωθείτε ότι η διεύθυνσή σας είναι αυτή με την οποία εγγραφήκατε."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-poštom ćemo vam poslati vezu za postavljanje nove lozinke. Provjerite je li vaša adresa ona s kojom ste se prijavili."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi skickar en länk till dig via e-post för att ange ett nytt lösenord. Se till att din adress är den du registrerade dig med."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir senden Ihnen per E-Mail einen Link zum Festlegen eines neuen Passworts. Stellen Sie sicher, dass Ihre Adresse mit der Adresse übereinstimmt, mit der Sie sich angemeldet haben."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще ви изпратим имейл с връзка за задаване на нова парола. Уверете се, че вашият адрес е този, с който сте се регистрирали."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zašleme vám e-mail s odkazem na nastavení nového hesla. Ujistěte se, že vaše adresa je ta, se kterou jste se zaregistrovali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi sender dig en e-mail med et link for at angive en ny adgangskode. Sørg for, at din adresse er den, du har tilmeldt dig."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Saadame teile meili teel lingi uue parooli määramiseks. Veenduge, et teie aadress on see, millega registreerusite."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetämme sinulle sähköpostilla linkin, jolla voit asettaa uuden salasanan. Varmista, että osoitteesi on se, jolla kirjauduit."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mailben elküldjük az új jelszó beállításához szükséges linket. Győződjön meg arról, hogy a címe megegyezik azzal, amellyel regisztrált."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mēs nosūtīsim jums e-pastā saiti, lai iestatītu jaunu paroli. Pārliecinieties, vai jūsu adrese ir tā, ar kuru reģistrējāties."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "El. paštu atsiųsime nuorodą, kad galėtumėte nustatyti naują slaptažodį. Įsitikinkite, kad jūsų adresas yra tas, kuriuo prisiregistravote."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślemy Ci e-mail z linkiem umożliwiającym ustawienie nowego hasła. Upewnij się, że Twój adres jest tym, pod którym się zarejestrowałeś."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vă vom trimite prin e-mail un link pentru a seta o nouă parolă. Asigurați-vă că adresa dvs. este cea la care v-ați înscris."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošleme vám e-mailom odkaz na nastavenie nového hesla. Uistite sa, že vaša adresa je tá, s ktorou ste sa zaregistrovali."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po e-pošti vam bomo poslali povezavo za nastavitev novega gesla. Prepričajte se, da je vaš naslov tisti, s katerim ste se prijavili."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们将通过电子邮件向您发送用于设置新密码的链接。确保您的地址是您注册时使用的地址。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नया पासवर्ड सेट करने के लिए हम आपको एक लिंक ईमेल करेंगे। सुनिश्चित करें कि आपका पता वही है जिससे आपने साइन अप किया था।"
          }
        }
      }
    },

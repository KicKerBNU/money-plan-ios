            "state": "translated",
            "value": "This permanently deletes your Money Plan account, all expenses, income, accounts, and categories. This cannot be undone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta Money Plan, todas as despesas, receitas, contas e categorias. Não dá para desfazer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente sua conta Money Plan, todas as despesas, receitas, contas e categorias. Não dá para desfazer."
          }
        },
        "pt-PT": {
          "stringUnit": {

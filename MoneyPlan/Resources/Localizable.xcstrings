          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muudatused kehtivad sellele korduvale ajakavale. Tulevaste korduste peatamiseks lülitage see välja."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",

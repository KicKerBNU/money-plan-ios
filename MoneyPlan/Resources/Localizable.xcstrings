          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Készpénz, bankszámlák és bevételekhez és kiadásokhoz használt kártyák."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaidra nauda, ​​bankas konti un kartes, kas tiek izmantotas ienākumu un izdevumu segšanai."

    "income.empty.body" : {
      "extractionState" : "stale",
      "localizations" : {
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавете заплата, плащания на свободна практика, наем или други постъпващи пари."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přidejte plat, platby na volné noze, nájemné nebo jakékoli další přicházející peníze."

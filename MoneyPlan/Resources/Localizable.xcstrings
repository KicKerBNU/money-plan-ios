    "categories.confirmDelete.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone. Categories that still have expenses can't be deleted."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "This can't be undone. Categories that still have expenses can't be deleted."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não pode ser desfeita. Categorias que ainda têm despesas não podem ser excluídas."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não pode ser desfeita. Categorias que ainda têm despesas não podem ser excluídas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não pode ser anulada. Categorias que ainda têm despesas não podem ser eliminadas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Las categorías que todavía tienen gastos no se pueden eliminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne peut pas être annulé. Les catégories qui comportent encore des dépenses ne peuvent pas être supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'operazione non può essere annullata. Le categorie che presentano ancora spese non possono essere eliminate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt. Categorieën die nog uitgaven hebben, kunnen niet worden verwijderd."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν μπορεί να αναιρεθεί. Οι κατηγορίες που εξακολουθούν να έχουν έξοδα δεν μπορούν να διαγραφούν."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovo se ne može poništiti. Kategorije koje još imaju troškove ne mogu se brisati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta kan inte ångras. Kategorier som fortfarande har utgifter kan inte raderas."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies kann nicht rückgängig gemacht werden. Kategorien, für die noch Ausgaben anfallen, können nicht gelöscht werden."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Това не може да бъде отменено. Категориите, които все още имат разходи, не могат да бъдат изтрити."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto nelze vrátit zpět. Kategorie, které mají stále výdaje, nelze smazat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette kan ikke fortrydes. Kategorier, der stadig har udgifter, kan ikke slettes."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Seda ei saa tagasi võtta. Kategooriaid, millel on veel kulusid, ei saa kustutada."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätä ei voi kumota. Luokkia, joissa on vielä kuluja, ei voi poistaa."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezt nem lehet visszavonni. Azok a kategóriák, amelyeknek még vannak kiadásai, nem törölhetők."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Šo darbību nevar atsaukt. Kategorijas, kurām joprojām ir izdevumi, nevar izdzēst."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "To negalima anuliuoti. Negalima ištrinti kategorijų, kuriose vis dar yra išlaidų."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego nie można cofnąć. Nie można usunąć kategorii, które nadal zawierają wydatki."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest lucru nu poate fi anulat. Categoriile care au încă cheltuieli nu pot fi șterse."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto sa nedá vrátiť späť. Kategórie, ktoré ešte majú výdavky, nemožno odstrániť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega ni mogoče razveljaviti. Kategorij, ki še imajo stroške, ni mogoče izbrisati."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这无法撤消。仍有费用的类别无法删除。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे पूर्ववत नहीं किया जा सकता. जिन श्रेणियों में अभी भी खर्च हैं उन्हें हटाया नहीं जा सकता।"
          }
        }
      }
    },

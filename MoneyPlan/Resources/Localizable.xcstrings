          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Sularaha, pangakontod ja kaardid, mida kasutatakse tulude ja kulude katmiseks."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",

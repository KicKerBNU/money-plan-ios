    "recurringIncome.empty.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark an income entry as recurring when you add it from Income, or link one when editing an existing entry."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark an income entry as recurring when you add it from Income, or link one when editing an existing entry."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma receita como recorrente ao adicioná-la em Receitas, ou vincule ao editar um lançamento existente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma receita como recorrente ao adicioná-la em Receitas, ou vincule ao editar um lançamento existente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque uma receita como recorrente ao adicioná-la em Receitas, ou vincule ao editar um lançamento existente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque una entrada de ingresos como recurrente cuando la agregue desde Ingresos o vincule una al editar una entrada existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez une entrée de revenu comme récurrente lorsque vous l'ajoutez à partir de Revenu, ou associez-en une lorsque vous modifiez une entrée existante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna una voce di reddito come ricorrente quando la aggiungi da Entrate o ne colleghi una quando modifichi una voce esistente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer een inkomensvermelding als terugkerend wanneer u deze toevoegt vanuit Inkomsten, of koppel er een wanneer u een bestaande invoer bewerkt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επισημάνετε μια εγγραφή εισοδήματος ως επαναλαμβανόμενη όταν την προσθέτετε από το Εισόδημα ή συνδέστε μια κατά την επεξεργασία μιας υπάρχουσας καταχώρισης."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite unos prihoda kao ponavljajući kada ga dodate iz Prihoda ili ga povežite kada uređujete postojeći unos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Markera en inkomstpost som återkommande när du lägger till den från Inkomst, eller länka en när du redigerar en befintlig post."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markieren Sie einen Einkommenseintrag als wiederkehrend, wenn Sie ihn über „Einkommen“ hinzufügen, oder verknüpfen Sie ihn, wenn Sie einen vorhandenen Eintrag bearbeiten."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Маркирайте запис за доход като повтарящ се, когато го добавяте от Доход, или свържете такъв, когато редактирате съществуващ запис."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte položku příjmu jako opakovanou, když ji přidáte z položky Příjem, nebo ji propojte při úpravě existující položky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Marker en indkomstpost som tilbagevendende, når du tilføjer den fra Indkomst, eller tilknyt en, når du redigerer en eksisterende post."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Märkige sissetulekukirje korduvaks, kui lisate selle jaotisest Tulud, või linkige see olemasoleva kirje muutmisel."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkitse tulomerkintä toistuvaksi, kun lisäät sen Tuloista, tai linkitä se, kun muokkaat olemassa olevaa merkintää."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelölje meg a bevételi bejegyzést ismétlődőként, amikor hozzáadja a Jövedelemből, vagy csatoljon egyet egy meglévő bejegyzés szerkesztésekor."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Atzīmējiet ienākumu ierakstu kā periodisku, kad to pievienojat sadaļā Ienākumi, vai saistiet to, rediģējot esošu ierakstu."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pažymėkite pajamų įrašą kaip pasikartojantį, kai pridedate jį iš pajamų, arba susiekite jį redaguodami esamą įrašą."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz wpis dochodu jako cykliczny podczas dodawania go z poziomu Dochody lub połącz go podczas edycji istniejącego wpisu."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcați o intrare de venit ca fiind recurentă atunci când o adăugați din Venit sau conectați una când editați o intrare existentă."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Označte záznam príjmu ako opakujúci sa, keď ho pridáte z príjmu, alebo ho prepojte pri úprave existujúceho záznamu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Označite vnos dohodka kot ponavljajočega se, ko ga dodate iz Dohodka, ali ga povežite, ko urejate obstoječ vnos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您从收入中添加收入条目时，将其标记为经常性收入条目，或者在编辑现有条目时链接一个收入条目。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप किसी आय प्रविष्टि को आय से जोड़ते हैं तो उसे आवर्ती के रूप में चिह्नित करें, या किसी मौजूदा प्रविष्टि को संपादित करते समय उसे लिंक करें।"
          }
        }
      }
    },

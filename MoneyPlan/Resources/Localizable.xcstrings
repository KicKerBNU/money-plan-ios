    "recurring.form.editLinkedFooter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply to this recurring schedule. Turn off to stop future repeats."
          }
        },
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes apply to this recurring schedule. Turn off to stop future repeats."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações aplicam-se a esta recorrência. Desligue para parar repetições futuras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações aplicam-se a esta recorrência. Desligue para parar repetições futuras."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterações aplicam-se a esta recorrência. Desligue para parar repetições futuras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplican cambios a este programa recurrente. Apague para detener futuras repeticiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des modifications s’appliquent à cet horaire récurrent. Désactivez-le pour arrêter les répétitions futures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si applicano a questo programma ricorrente. Disattiva per interrompere le ripetizioni future."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit terugkerende rooster zijn wijzigingen van toepassing. Schakel uit om toekomstige herhalingen te stoppen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ισχύουν αλλαγές σε αυτό το επαναλαμβανόμενο πρόγραμμα. Απενεργοποιήστε για να σταματήσετε τις μελλοντικές επαναλήψεις."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Promjene se primjenjuju na ovaj ponavljajući raspored. Isključite za zaustavljanje budućih ponavljanja."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar gäller för detta återkommande schema. Stäng av för att stoppa framtida upprepningar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen wiederkehrenden Zeitplan gelten Änderungen. Schalten Sie diese Option aus, um zukünftige Wiederholungen zu stoppen."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промените се прилагат към този периодичен график. Изключете, за да спрете бъдещите повторения."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Změny se týkají tohoto opakovaného rozvrhu. Vypnutím zastavíte budoucí opakování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ændringer gælder for denne tilbagevendende tidsplan. Sluk for at stoppe fremtidige gentagelser."
          }
        },
        "et": {
          "stringUnit": {
            "state": "translated",
            "value": "Muudatused kehtivad sellele korduvale ajakavale. Tulevaste korduste peatamiseks lülitage see välja."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muutokset koskevat tätä toistuvaa aikataulua. Sammuta, jos haluat lopettaa tulevat toistot."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A változások erre az ismétlődő menetrendre vonatkoznak. Kapcsolja ki a jövőbeli ismétlődések leállításához."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Izmaiņas attiecas uz šo periodisko grafiku. Izslēdziet, lai apturētu atkārtošanos nākotnē."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "translated",
            "value": "Šiam pasikartojančiam grafikui taikomi pakeitimai. Išjunkite, kad sustabdytumėte pasikartojimą ateityje."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany dotyczą tego harmonogramu cyklicznego. Wyłącz, aby zatrzymać przyszłe powtórzenia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările se aplică acestui program recurent. Opriți pentru a opri repetările viitoare."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmeny sa vzťahujú na tento opakujúci sa rozvrh. Vypnutím zastavíte budúce opakovania."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremembe veljajo za ta ponavljajoči se urnik. Izklopite, če želite ustaviti prihodnja ponavljanja."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改适用于该定期计划。关闭以停止将来的重复。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आवर्ती शेड्यूल पर परिवर्तन लागू होते हैं. भविष्य में पुनरावृत्ति रोकने के लिए बंद करें."
          }
        }
      }
    },
